# Runtime: DEVELOPMENT | TEST | DEMO | PILOT | PRODUCTION
APP_ENV=DEVELOPMENT
DATABASE_URL=sqlite:///./marine_observations.db
# Pilot/staging example (credentials supplied outside source control):
# DATABASE_URL=postgresql+psycopg://marine_app:CHANGE_ME@postgres:5432/marine_monitoring
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET=
UPLOAD_DIRECTORY=uploads/observations
ARTIFACT_DIRECTORY=artifacts
BACKUP_DIRECTORY=backups/managed
LOG_LEVEL=INFO
PROVIDER_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SUBMISSION_PER_MINUTE=12
EVENT_WORKER_ENABLED=false
AUTOMATIC_SCIENTIFIC_EVALUATION_ENABLED=false
MAX_EVENT_ATTEMPTS=3
BACKUP_RETENTION_COUNT=14
DEMO_MODE=false
VITE_API_BASE_URL=http://localhost:8000
